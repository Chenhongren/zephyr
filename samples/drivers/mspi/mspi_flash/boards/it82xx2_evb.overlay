#include <freq.h>

/ {
	aliases {
		flash0 = &mx25r16;
	};
};

&spi0 {
	status = "okay";

	pinctrl-0 = <&spi_ssce0_default
		     &spi_ssce1_default
		     &spi_ssck_default
		     &spi_smosi_default
		     &spi_smiso_default
		     &spi_sio2_default
		     &spi_sio3_default>;
	pinctrl-names = "default";

	mx25r16: mx25v1635f@1 {
		compatible = "jedec,mspi-nor";
		reg = <1>;
		size = <DT_SIZE_M(512)>;
		status = "okay";
		mspi-max-frequency = <DT_FREQ_M(3)>;
		mspi-io-mode = "MSPI_IO_MODE_SINGLE";
		mspi-data-rate = "MSPI_DATA_RATE_SINGLE";
		mspi-hardware-ce-num = <1>;
		read-command = <0x0b>;
		write-command = <0x02>;
		command-length = "INSTR_1_BYTE";
		address-length = "ADDR_3_BYTE";
		rx-dummy = <20>;
		jedec-id = [c2 23 15];

		// use-4byte-addressing;
		//initial-soft-reset;
		transfer-timeout = <1000>;
	};

	mx25l10: mx25l1006e@0 {
		compatible = "jedec,mspi-nor";
		reg = <0>;
		mspi-max-frequency = <DT_FREQ_M(3)>;
		mspi-io-mode = "MSPI_IO_MODE_SINGLE";
		jedec-id = [c2 20 11];
		size = <0x100000>; // 1Mb
	};
};
