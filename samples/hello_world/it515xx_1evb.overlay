&i3c0 {
	status = "okay";
	pinctrl-0 = <&i3c0_clk_gpj3_default
		     &i3c0_data_gpj4_default>;
	pinctrl-names = "default";
	i3c-od-scl-lo-period-ns = <360>;
	/* I3C pp 12.5MHz */
	i3c-pp-scl-hi-period-ns = <40>;
	i3c-pp-scl-lo-period-ns = <40>;

	i3c_dummy@18000005fa12345678 {
		compatible = "ite,i3c-ctrl-dummy";
		reg = <0x18 0x05fa 0x12345678>;
		label = "i3c_dummy_1";
		supports-setaasa;
		status = "okay";
	};
	i3c_dummy@19000005fa00010000 {
		compatible = "ite,i3c-ctrl-dummy";
		reg = <0x19 0x05fa 0x00010000>;
		label = "i3c_dummy_2";
		supports-setaasa;
		status = "okay";
	};
};

&i3c1 {
	status = "okay";
	pinctrl-0 = <
		     &i3c1_clk_gpj5_default
		     &i3c1_data_gpe1_default>;
	pinctrl-names = "default";
	/* Frequency 400KHz */
	//i3c-od-scl-lo-period-ns = <1250>;
	//i3c-pp-scl-hi-period-ns = <1250>;
	//i3c-pp-scl-lo-period-ns = <1250>;
	//i3c-clk-after-start-ns = <1250>;
	//i3c-clk-before-stop-ns = <1250>;
	//i3c-clk-after-sr-ns = <1250>;
	//i3c-clk-before-sr-ns = <1250>;

	/* Frequency 1MHz */
	i3c-od-scl-lo-period-ns = <500>;
	i3c-pp-scl-hi-period-ns = <500>;
	i3c-pp-scl-lo-period-ns = <500>;
	i3c-clk-after-start-ns = <500>;
	i3c-clk-before-stop-ns = <500>;
	i3c-clk-after-sr-ns = <500>;
	i3c-clk-before-sr-ns = <500>;

	lps22df@000000020800b4900b {
		//compatible = "st,lps22df";
		compatible = "ite,i3c-ctrl-dummy";
		reg = <0x00 0x0208 0x00b4900b>;
		label = "i3c_sensor_2";
		status = "okay";
	};
};

&i3c2 {
	status = "okay";
	pinctrl-0 = <
		     &i3c2_clk_gpe2_default
		     &i3c2_data_gpe3_default>;
	pinctrl-names = "default";
	static-address = <0x18>;
	pid-random-value = <0x12345678>;
	bcr = <0xf>; // With ibi payload
	dcr = <0x1>;

	tgt_mqueue@18 {
		compatible = "ite,i3c-tgt-mqueue";
		reg = <0x18>;
		label = "tgt-mqueue";
		status = "okay";
	};
};

&i3c3 {
	status = "okay";
	pinctrl-0 = <
		     &i3c3_clk_gpf0_default
		     &i3c3_data_gpf1_default>;
	pinctrl-names = "default";
	static-address = <0x19>;
	bcr = <0xb>; // Without ibi payload
	dcr = <0x2>;

	tgt_mqueue1@19 {
		compatible = "ite,i3c-tgt-mqueue";
		reg = <0x19>;
		label = "tgt-mqueue1";
		status = "okay";
	};
};
