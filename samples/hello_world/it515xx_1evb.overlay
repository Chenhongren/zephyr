&i3c0 {
	status = "okay";
	pinctrl-0 = <&i3c0_clk_gpj3_default
		     &i3c0_data_gpj4_default>;
	pinctrl-names = "default";
	i3c-scl-hz = <125000000>;
	i3c-od-scl-hz = <400000>;
	//i2c-scl-hz = <400000>;
	//i3c-scl-hddat = <1>;
	i2c-scl-hddat = <2>;

	i3c_dummy@18000005fa12345678 {
		compatible = "ite,i3c-ctrl-dummy";
		reg = <0x18 0x05fa 0x12345678>;
		label = "i3c_dummy_1";
		supports-setaasa;
		status = "okay";
	};
	i3c_dummy@19000005fa00010000 {
		compatible = "ite,i3c-ctrl-dummy";
		reg = <0x19 0x05fa 0x00010000>;
		label = "i3c_dummy_2";
		supports-setaasa;
		status = "okay";
	};

	i2c_lps22df@5d {
		reg = <0x5D 0x00 0x00>;
		status = "okay";
	};
};

&i3c2 {
	status = "okay";
	pinctrl-0 = <
		     &i3c2_clk_gpe2_default
		     &i3c2_data_gpe3_default>;
	pinctrl-names = "default";
	static-address = <0x18>;
	pid-random-value = <0x12345678>;
	bcr = <0xf>; // With ibi payload
	dcr = <0x1>;

	tgt_mqueue@18 {
		compatible = "ite,i3c-tgt-mqueue";
		reg = <0x18>;
		label = "tgt-mqueue";
		status = "okay";
	};
};

&i3c3 {
	status = "okay";
	pinctrl-0 = <
		     &i3c3_clk_gpf0_default
		     &i3c3_data_gpf1_default>;
	pinctrl-names = "default";
	static-address = <0x19>;
	bcr = <0xb>; // Without ibi payload
	dcr = <0x2>;

	tgt_mqueue1@19 {
		compatible = "ite,i3c-tgt-mqueue";
		reg = <0x19>;
		label = "tgt-mqueue1";
		status = "okay";
	};
};
