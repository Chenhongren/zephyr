#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	aliases {
		test-comp = &vcmp1;
	};

	zephyr,user {
		test-gpios = <&gpioa 1 GPIO_ACTIVE_HIGH>;
	};
};

&adc0 {
	status = "okay";
	pinctrl-0 = <&adc0_ch3_gpi3_default>;
	pinctrl-names = "default";
};

&vcmp1 {
	status = "okay";
	threshold-mv = <1500>;
	scan-period = <0x4>;
	io-channels = <&adc0 3>;
};
